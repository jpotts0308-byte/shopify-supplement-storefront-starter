{% comment %}
QDW Feature Cards — reusable Shopify Online Store 2.0 section.
Text-only editable cards. No urgency, countdown, health, or performance claims.
Install in sections/qdw-feature-cards.liquid of a development theme, then add using theme editor.
{% endcomment %}
<section class="qdw-feature-cards" aria-label="{{ section.settings.heading | escape }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="qdw-feature-cards__grid">
      {% for block in section.blocks %}
        <article class="qdw-feature-cards__item" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
          {% if block.settings.body != blank %}<p>{{ block.settings.body | escape | newline_to_br }}</p>{% endif %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'Learn more' | escape }}</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
<style>
  .qdw-feature-cards { padding: 2rem 0; }
  .qdw-feature-cards__grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr)); gap:1.2rem; }
  .qdw-feature-cards__item { padding:1.4rem; border:1px solid rgba(0,0,0,.15); border-radius:12px; }
  .qdw-feature-cards__item h3 { margin:0 0 .6rem; }
  .qdw-feature-cards__item a:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
</style>
{% schema %}
{
  "name": "QDW Feature Cards",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with us" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "body", "label": "Description", "default": "Add a factual, approved description." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "Learn more" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "QDW Feature Cards", "blocks": [{"type":"card"},{"type":"card"},{"type":"card"}] }
  ]
}
{% endschema %}
